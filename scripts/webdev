#!/usr/bin/env python3
"""muse-webdev launcher. Usage: webdev run <script.py> <url> | webdev doctor"""
import json, os, subprocess, sys
ROOT = os.path.dirname(os.path.abspath(__file__))
if len(sys.argv) >= 2 and sys.argv[1] == "doctor":
    print(json.dumps({"ready": True, "plugin_version": "0.2.0",
                      "python_version": f"{sys.version_info.major}.{sys.version_info.minor}",
                      "mode": "manual", "reasons": []}))
    sys.exit(0)
if len(sys.argv) >= 3 and sys.argv[1] == "run":
    script = os.path.join(ROOT, sys.argv[2])
    if not os.path.isfile(script):
        print(f"unknown script: {sys.argv[2]}", file=sys.stderr); sys.exit(2)
    sys.exit(subprocess.call([sys.executable, script] + sys.argv[3:]))
print("usage: webdev run <script.py> <url> | webdev doctor", file=sys.stderr)
sys.exit(2)
